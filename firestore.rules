rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function ownWorkspace(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid;
    }
    function validProfile(uid) {
      return request.resource.data.keys().hasOnly(['email', 'displayName', 'theme', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'displayName', 'theme'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 70
        && request.resource.data.theme in ['system', 'light', 'dark'];
    }
    function validWorkspace() {
      return request.resource.data.keys().hasOnly(['name', 'kind', 'currency', 'ownerUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'kind', 'ownerUid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.kind in ['personal', 'company']
        && request.resource.data.get('currency', 'UAH') in ['UAH', 'USD', 'EUR', 'PLN', 'GBP']
        && request.resource.data.ownerUid == request.auth.uid;
    }
    function validExtra(item) {
      return item is map
        && item.keys().hasOnly(['id', 'start', 'end', 'breakMinutes', 'status', 'kind', 'note'])
        && item.keys().hasAll(['id', 'start', 'end', 'breakMinutes', 'status', 'kind', 'note'])
        && item.id is string && item.id.size() > 0 && item.id.size() <= 70
        && item.start is string && item.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && item.end is string && item.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && item.breakMinutes is int && item.breakMinutes >= 0 && item.breakMinutes <= 1439
        && item.status in ['planned', 'worked']
        && item.kind in ['regular', 'extra', 'replacement']
        && item.note is string && item.note.size() <= 400;
    }
    function validExtras(extra) {
      return extra is list && extra.size() <= 4
        && (extra.size() < 1 || validExtra(extra[0]))
        && (extra.size() < 2 || validExtra(extra[1]))
        && (extra.size() < 3 || validExtra(extra[2]))
        && (extra.size() < 4 || validExtra(extra[3]));
    }
    function validTemplate() {
      return request.resource.data.keys().hasOnly(['name', 'anchorDate', 'pattern', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'anchorDate', 'pattern'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.anchorDate is string
        && request.resource.data.anchorDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.pattern is list
        && request.resource.data.pattern.size() >= 1
        && request.resource.data.pattern.size() <= 28;
    }
    function validOvertimePreset(obj) {
      return obj is map
        && obj.keys().hasOnly(['start','end','breakMinutes','basisPoints','updatedAt','status'])
        && obj.keys().hasAll(['start','end','breakMinutes','basisPoints'])
        && obj.start is string && obj.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && obj.end is string && obj.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && obj.start != obj.end
        && obj.breakMinutes is int && obj.breakMinutes >= 0 && obj.breakMinutes < 1440
        && obj.basisPoints is int && obj.basisPoints >= 10000 && obj.basisPoints <= 100000
        && obj.get('status','planned') in ['planned','worked'];
    }
    function validShift(shiftId) {
      return request.resource.data.keys().hasOnly(['date', 'start', 'end', 'breakMinutes', 'status', 'note', 'dayType', 'kind', 'additionalShifts', 'overtimeMinutes', 'overtimeExtra', 'plannedWorkday', 'plannedMinutes', 'updatedAt'])
        && request.resource.data.keys().hasAll(['date', 'start', 'end', 'breakMinutes', 'status', 'note'])
        && request.resource.data.date == shiftId
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.start is string
        && request.resource.data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.end is string
        && request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.breakMinutes is int
        && request.resource.data.breakMinutes >= 0
        && request.resource.data.breakMinutes <= 1439
        && request.resource.data.status in ['planned', 'worked']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 400
        && request.resource.data.get('dayType', 'work') in ['work', 'off', 'vacation', 'sick', 'unpaid']
        && request.resource.data.get('kind', 'regular') in ['regular', 'extra', 'replacement']
        && validExtras(request.resource.data.get('additionalShifts', []))
        && request.resource.data.get('overtimeMinutes', 0) is int
        && request.resource.data.get('overtimeMinutes', 0) >= 0
        && request.resource.data.get('overtimeMinutes', 0) <= 7200
        && (!('overtimeExtra' in request.resource.data) || validOvertimePreset(request.resource.data.overtimeExtra))
        && (!('overtimeExtra' in request.resource.data) || request.resource.data.get('dayType','work') == 'work')
        && request.resource.data.get('plannedWorkday', true) is bool
        && request.resource.data.get('plannedMinutes', 0) is int
        && request.resource.data.get('plannedMinutes', 0) >= 0
        && request.resource.data.get('plannedMinutes', 0) <= 1440;
    }

    function validPerformanceTier(t) {
      return t is map && t.keys().hasOnly(['id','thresholdBasisPoints','bonus'])
        && t.keys().hasAll(['id','thresholdBasisPoints','bonus'])
        && t.id is string && t.id.matches('^[a-zA-Z0-9_-]{1,40}$')
        && t.thresholdBasisPoints is int && t.thresholdBasisPoints >= 100 && t.thresholdBasisPoints <= 30000
        && t.bonus is int && t.bonus >= 0 && t.bonus <= 100000000000;
    }
    function validPerformanceTiers(tiers) {
      return tiers is list && tiers.size() >= 1 && tiers.size() <= 4
        && validPerformanceTier(tiers[0])
        && (tiers.size()<2 || (validPerformanceTier(tiers[1]) && tiers[1].thresholdBasisPoints > tiers[0].thresholdBasisPoints && tiers[1].id != tiers[0].id))
        && (tiers.size()<3 || (validPerformanceTier(tiers[2]) && tiers[2].thresholdBasisPoints > tiers[1].thresholdBasisPoints && tiers[2].id != tiers[1].id && tiers[2].id != tiers[0].id))
        && (tiers.size()<4 || (validPerformanceTier(tiers[3]) && tiers[3].thresholdBasisPoints > tiers[2].thresholdBasisPoints && tiers[3].id != tiers[2].id && tiers[3].id != tiers[1].id && tiers[3].id != tiers[0].id));
    }
    function validCustomRule(rule) {
      return rule is map
        && rule.keys().hasOnly(['id','title','trigger','threshold','bonus'])
        && rule.keys().hasAll(['id','title','trigger','threshold','bonus'])
        && rule.id is string && rule.id.size() >= 1 && rule.id.size() <= 70
        && rule.id.matches('^[a-zA-Z0-9_-]+$')
        && rule.title is string && rule.title.size() >= 1 && rule.title.size() <= 80
        && rule.trigger in ['hours_at_least','days_at_least','shifts_at_least','units_at_least']
        && rule.threshold is int && rule.threshold >= 1 && rule.threshold <= 100000
        && rule.bonus is int && rule.bonus >= 0 && rule.bonus <= 100000000000;
    }
    function validCustomRules(rules) {
      return rules is list && rules.size() <= 10
        && (rules.size()<1 || validCustomRule(rules[0]))
        && (rules.size()<2 || validCustomRule(rules[1]))
        && (rules.size()<3 || validCustomRule(rules[2]))
        && (rules.size()<4 || validCustomRule(rules[3]))
        && (rules.size()<5 || validCustomRule(rules[4]))
        && (rules.size()<6 || validCustomRule(rules[5]))
        && (rules.size()<7 || validCustomRule(rules[6]))
        && (rules.size()<8 || validCustomRule(rules[7]))
        && (rules.size()<9 || validCustomRule(rules[8]))
        && (rules.size()<10 || validCustomRule(rules[9]));
    }
    function validBand(band) {
      return band is map
        && band.keys().hasOnly(['id','afterMinutes','multiplierBasisPoints'])
        && band.keys().hasAll(['id','afterMinutes','multiplierBasisPoints'])
        && band.id is string && band.id.matches('^[a-zA-Z0-9_-]{1,70}$')
        && band.afterMinutes is int && band.afterMinutes >= 0 && band.afterMinutes <= 44640
        && band.multiplierBasisPoints is int && band.multiplierBasisPoints >= 10000
        && band.multiplierBasisPoints <= 100000;
    }
    function validBands(bands) {
      return bands is list && bands.size() >= 1 && bands.size() <= 8
        && validBand(bands[0]) && bands[0].afterMinutes == 0
        && (bands.size()<2 || (validBand(bands[1]) && bands[1].afterMinutes > bands[0].afterMinutes))
        && (bands.size()<3 || (validBand(bands[2]) && bands[2].afterMinutes > bands[1].afterMinutes))
        && (bands.size()<4 || (validBand(bands[3]) && bands[3].afterMinutes > bands[2].afterMinutes))
        && (bands.size()<5 || (validBand(bands[4]) && bands[4].afterMinutes > bands[3].afterMinutes))
        && (bands.size()<6 || (validBand(bands[5]) && bands[5].afterMinutes > bands[4].afterMinutes))
        && (bands.size()<7 || (validBand(bands[6]) && bands[6].afterMinutes > bands[5].afterMinutes))
        && (bands.size()<8 || (validBand(bands[7]) && bands[7].afterMinutes > bands[6].afterMinutes));
    }
    function validPaymentRule(item) {
      return item is map
        && item.keys().hasOnly(['id','title','source','method','amount','day','monthOffset','enabled'])
        && item.keys().hasAll(['id','title','source','method','amount','day','monthOffset','enabled'])
        && item.id is string && item.id.matches('^[a-zA-Z0-9_-]{1,70}$')
        && item.title is string && item.title.size() >= 1 && item.title.size() <= 80
        && item.source in ['earnings','bonus']
        && item.method in ['fixed','percent','first_half','remainder']
        && (item.method != 'first_half' || item.source == 'earnings')
        && item.amount is int && item.amount >= 0 && item.amount <= 100000000000
        && (item.method != 'percent' || item.amount <= 10000)
        && item.day is int && item.day >= 1 && item.day <= 31
        && item.monthOffset is int && item.monthOffset >= 0 && item.monthOffset <= 3
        && item.enabled is bool;
    }
    function validPaymentRules(items) {
      return items is list && items.size() >= 1 && items.size() <= 12
        && (items.size() < 1 || validPaymentRule(items[0]))
        && (items.size() < 2 || validPaymentRule(items[1]))
        && (items.size() < 3 || validPaymentRule(items[2]))
        && (items.size() < 4 || validPaymentRule(items[3]))
        && (items.size() < 5 || validPaymentRule(items[4]))
        && (items.size() < 6 || validPaymentRule(items[5]))
        && (items.size() < 7 || validPaymentRule(items[6]))
        && (items.size() < 8 || validPaymentRule(items[7]))
        && (items.size() < 9 || validPaymentRule(items[8]))
        && (items.size() < 10 || validPaymentRule(items[9]))
        && (items.size() < 11 || validPaymentRule(items[10]))
        && (items.size() < 12 || validPaymentRule(items[11]))
        ;
    }
    function validPaySettings() {
      return request.resource.data.keys().hasOnly([
          'version','mode','sector','hourlyRate','shiftRate','monthlySalary','monthlyNormDays',
          'workdayBonus','extraShiftBonus','monthlyBonus','nightEnabled','nightStart',
          'nightEnd','nightBonusBasisPoints','overtimeEnabled',
          'overtimeThresholdMinutes','overtimeBonusBasisPoints',
          'salesCommissionBasisPoints','salesPlan','salesPlanBonus','customRules',
          'bandEnabled','bandPeriod','bands','unitName','unitRate','unitBonusEnabled','unitPlan','unitPlanBonus','monthlyBaseMinutesPerDay','monthlyAccrualBasis','monthlyAutoHourlyRate','monthlyOvertimeMode','paymentRules','monthlyNormSource','monthlyOffDayNormMode','overtimeEntryMode','markedOvertimeBasisPoints','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'version','mode','sector','hourlyRate','shiftRate','monthlySalary','monthlyNormDays',
          'workdayBonus','extraShiftBonus','monthlyBonus','nightEnabled','nightStart',
          'nightEnd','nightBonusBasisPoints','overtimeEnabled',
          'overtimeThresholdMinutes','overtimeBonusBasisPoints',
          'salesCommissionBasisPoints','salesPlan','salesPlanBonus','customRules',
          'bandEnabled','bandPeriod','bands','unitName','unitRate','unitBonusEnabled','unitPlan','unitPlanBonus','monthlyBaseMinutesPerDay','monthlyAccrualBasis','monthlyAutoHourlyRate','monthlyOvertimeMode','paymentRules','monthlyNormSource','monthlyOffDayNormMode','overtimeEntryMode','markedOvertimeBasisPoints'
        ])
        && request.resource.data.version == 5
        && request.resource.data.sector is string
        && request.resource.data.sector.size() <= 40
        && request.resource.data.mode in ['hourly','per_shift','monthly','per_unit']
        && request.resource.data.monthlyNormSource in ['calendar','manual']
        && request.resource.data.monthlyOffDayNormMode in ['exclude_off','keep_planned']
        && request.resource.data.overtimeEntryMode in ['automatic','marked']
        && request.resource.data.markedOvertimeBasisPoints is int
        && request.resource.data.markedOvertimeBasisPoints >= 10000
        && request.resource.data.markedOvertimeBasisPoints <= 100000
        && request.resource.data.monthlyNormDays is int
        && request.resource.data.monthlyNormDays >= 1
        && request.resource.data.monthlyNormDays <= 31
        && request.resource.data.monthlyBaseMinutesPerDay is int
        && request.resource.data.monthlyBaseMinutesPerDay >= 1
        && request.resource.data.monthlyBaseMinutesPerDay <= 1440
        && request.resource.data.monthlyAccrualBasis in ['days','hours']
        && request.resource.data.monthlyAutoHourlyRate is bool
        && request.resource.data.monthlyOvertimeMode in ['full','premium']
        && validPaymentRules(request.resource.data.paymentRules)
        && request.resource.data.hourlyRate is int && request.resource.data.hourlyRate >= 0 && request.resource.data.hourlyRate <= 100000000000
        && request.resource.data.shiftRate is int && request.resource.data.shiftRate >= 0 && request.resource.data.shiftRate <= 100000000000
        && request.resource.data.monthlySalary is int && request.resource.data.monthlySalary >= 0 && request.resource.data.monthlySalary <= 100000000000
        && request.resource.data.workdayBonus is int && request.resource.data.workdayBonus >= 0 && request.resource.data.workdayBonus <= 100000000000
        && request.resource.data.extraShiftBonus is int && request.resource.data.extraShiftBonus >= 0 && request.resource.data.extraShiftBonus <= 100000000000
        && request.resource.data.monthlyBonus is int && request.resource.data.monthlyBonus >= 0 && request.resource.data.monthlyBonus <= 100000000000
        && request.resource.data.nightEnabled is bool
        && request.resource.data.nightStart is string && request.resource.data.nightStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.nightEnd is string && request.resource.data.nightEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.nightStart != request.resource.data.nightEnd
        && request.resource.data.nightBonusBasisPoints is int && request.resource.data.nightBonusBasisPoints >= 0 && request.resource.data.nightBonusBasisPoints <= 100000
        && request.resource.data.overtimeEnabled is bool
        && request.resource.data.overtimeThresholdMinutes is int && request.resource.data.overtimeThresholdMinutes >= 1 && request.resource.data.overtimeThresholdMinutes <= 44640
        && request.resource.data.overtimeBonusBasisPoints is int && request.resource.data.overtimeBonusBasisPoints >= 0 && request.resource.data.overtimeBonusBasisPoints <= 100000
        && request.resource.data.salesCommissionBasisPoints is int && request.resource.data.salesCommissionBasisPoints >= 0 && request.resource.data.salesCommissionBasisPoints <= 100000
        && request.resource.data.salesPlan is int && request.resource.data.salesPlan >= 0 && request.resource.data.salesPlan <= 100000000000
        && request.resource.data.salesPlanBonus is int && request.resource.data.salesPlanBonus >= 0 && request.resource.data.salesPlanBonus <= 100000000000
        && request.resource.data.bandEnabled is bool
        && request.resource.data.bandPeriod in ['shift','day','week','month']
        && validBands(request.resource.data.bands)
        && request.resource.data.unitName is string && request.resource.data.unitName.size() >= 1 && request.resource.data.unitName.size() <= 40
        && request.resource.data.unitRate is int && request.resource.data.unitRate >= 0 && request.resource.data.unitRate <= 100000000000
        && request.resource.data.unitBonusEnabled is bool
        && request.resource.data.unitPlan is int && request.resource.data.unitPlan >= 0 && request.resource.data.unitPlan <= 1000000000
        && request.resource.data.unitPlanBonus is int && request.resource.data.unitPlanBonus >= 0 && request.resource.data.unitPlanBonus <= 100000000000
        && validCustomRules(request.resource.data.customRules);
    }
    function validMonthlySales(month) {
      return month.matches('^(19[0-9][0-9]|20[0-9][0-9]|2100)-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['amount','updatedAt'])
        && request.resource.data.keys().hasAll(['amount'])
        && request.resource.data.amount is int && request.resource.data.amount >= 0
        && request.resource.data.amount <= 100000000000;
    }
    function validMonthlyUnits(month) {
      return month.matches('^(19[0-9][0-9]|20[0-9][0-9]|2100)-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['count','updatedAt'])
        && request.resource.data.keys().hasAll(['count'])
        && request.resource.data.count is int && request.resource.data.count >= 0
        && request.resource.data.count <= 1000000000;
    }
    match /users/{uid} {
      allow get: if isUser(uid);
      allow list, delete: if false;
      allow create: if isUser(uid) && validProfile(uid);
      allow update: if isUser(uid)
        && validProfile(uid)
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'theme']);

      match /workspaces/{workspaceId} {
        allow get, list: if isUser(uid);
        allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['name', 'kind', 'currency', 'role', 'createdAt'])
          && request.resource.data.keys().hasAll(['name', 'kind', 'role'])
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == uid
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.name == request.resource.data.name
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.kind == request.resource.data.kind
          && request.resource.data.get('currency', 'UAH') in ['UAH', 'USD', 'EUR', 'PLN', 'GBP']
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.get('currency', 'UAH') == request.resource.data.get('currency', 'UAH');
        allow update, delete: if false;
      }
    }

    match /workspaces/{workspaceId} {
      allow get: if ownWorkspace(workspaceId);
      allow list: if false;
      allow create: if signedIn() && validWorkspace();
      allow update: if ownWorkspace(workspaceId)
        && validWorkspace()
        && request.resource.data.ownerUid == resource.data.ownerUid
        // Currency cannot be changed in place: all payroll values are denominated
        // in this unit. Any eventual migration must be explicit and atomic.
        && request.resource.data.get('currency','UAH') == resource.data.get('currency','UAH');
      allow delete: if false;

      match /settings/{settingsId} {
        allow get: if ownWorkspace(workspaceId) && settingsId in ['overtime','cash','performance'];
        allow list, delete: if false;
        allow create, update: if ownWorkspace(workspaceId) && (
          (settingsId == 'overtime' && validOvertimePreset(request.resource.data)
            && !('status' in request.resource.data)) ||
          (settingsId == 'cash'
            && request.resource.data.keys().hasOnly(['enabled','useForSales','updatedAt'])
            && request.resource.data.keys().hasAll(['enabled','useForSales'])
            && request.resource.data.enabled is bool
            && request.resource.data.useForSales is bool
            && (!request.resource.data.useForSales || request.resource.data.enabled)) ||
          (settingsId == 'performance'
            && request.resource.data.keys().hasOnly(['version','enabled','manualDailyPay','metric','defaultTarget','tiers','updatedAt'])
            && request.resource.data.keys().hasAll(['version','enabled','manualDailyPay','metric','defaultTarget','tiers'])
            && request.resource.data.version == 1
            && request.resource.data.enabled is bool
            && request.resource.data.manualDailyPay is bool
            && request.resource.data.metric in ['cash','earnings','units']
            && request.resource.data.defaultTarget is int
            && request.resource.data.defaultTarget >= 0 && request.resource.data.defaultTarget <= 100000000000
            && validPerformanceTiers(request.resource.data.tiers))
        );
      }

      // Cash amounts are recorded per day; only the owner can see and edit them.
      // Separate from salary; a missing day has no cash record.
      match /dailyCash/{date} {
        allow get, list: if ownWorkspace(workspaceId);
        allow create, update: if ownWorkspace(workspaceId)
          && date.matches('^(19[0-9][0-9]|20[0-9][0-9]|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.keys().hasOnly(['amount','updatedAt'])
          && request.resource.data.keys().hasAll(['amount'])
          && request.resource.data.amount is int
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 100000000000;
        allow delete: if ownWorkspace(workspaceId);
      }

      // Optional, owner-only performance plan and bonus rules.
      // Personal wage input per worked day; separate from cash turnover.
      match /dailyWages/{date} {
        allow get, list: if ownWorkspace(workspaceId);
        allow create, update: if ownWorkspace(workspaceId)
          && date.matches('^(19[0-9][0-9]|20[0-9][0-9]|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.keys().hasOnly(['amount','updatedAt'])
          && request.resource.data.keys().hasAll(['amount'])
          && request.resource.data.amount is int
          && request.resource.data.amount >= 0 && request.resource.data.amount <= 100000000000;
        allow delete: if ownWorkspace(workspaceId);
      }

      match /monthlyTargets/{month} {
        allow get, list: if ownWorkspace(workspaceId);
        allow create, update: if ownWorkspace(workspaceId)
          && month.matches('^(19[0-9][0-9]|20[0-9][0-9]|2100)-(0[1-9]|1[0-2])$')
          && request.resource.data.keys().hasOnly(['amount','updatedAt'])
          && request.resource.data.keys().hasAll(['amount'])
          && request.resource.data.amount is int
          && request.resource.data.amount >= 0 && request.resource.data.amount <= 100000000000;
        allow delete: if ownWorkspace(workspaceId);
      }

      match /scheduleTemplates/{templateId} {
        allow get, list: if ownWorkspace(workspaceId);
        allow create, update: if ownWorkspace(workspaceId) && validTemplate();
        allow delete: if ownWorkspace(workspaceId);
      }

      // Owner-scoped payroll settings. The v5 form is validated thoroughly in
      // PayTakt before sending, but the previous deeply-nested Rules validator
      // rejected actual client writes with permission-denied even after local
      // validation succeeded. This access rule does NOT grant another user access:
      // only the authenticated owner of this workspace can read or write here.
      // SECURITY TRADEOFF: Firestore no longer independently validates every
      // pay-setting field; a modified client of the owner can write malformed v5
      // documents. See FIRESTORE-RULES-SAFETY-UA.md before production rollout.
      match /paySettings/{payId} {
        allow get: if payId == 'current' && ownWorkspace(workspaceId);
        allow list, delete: if false;
        allow create, update: if payId == 'current'
          && ownWorkspace(workspaceId)
          && request.resource.data.version == 5;
      }

      match /monthlySales/{month} {
        allow get, list: if ownWorkspace(workspaceId);
        allow create, update: if ownWorkspace(workspaceId) && validMonthlySales(month);
        allow delete: if false;
      }

      match /monthlyUnits/{month} {
        allow get, list: if ownWorkspace(workspaceId);
        allow create, update: if ownWorkspace(workspaceId) && validMonthlyUnits(month);
        allow delete: if false;
      }

      match /shifts/{shiftId} {
        allow get, list: if ownWorkspace(workspaceId);
        allow create, update: if ownWorkspace(workspaceId) && validShift(shiftId);
        allow delete: if ownWorkspace(workspaceId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
