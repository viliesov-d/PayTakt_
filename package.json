{
  "name": "paytakt",
  "private": true,
  "version": "2.0.0-beta.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "android:setup": "node scripts/setup-android.mjs",
    "android:sync": "npm run build && cap sync android && npm run android:icon",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:icon": "java scripts/GenerateAndroidIcon.java",
    "ios:sync": "npm run build && node scripts/set-ios-version.mjs && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "ios:icon": "java scripts/GenerateIosIcon.java"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "firebase": "^12.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
